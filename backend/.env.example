# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# Allowed browser origin for CORS (the frontend dev server)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string:
# Atlas > Database > Connect > Drivers > copy the string, then put your DB user's
# password in and add a database name (leadflow) before the "?".
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/leadflow?retryWrites=true&w=majority

# Signs login tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Optional: bcrypt cost for password hashing (4-15, default 12). Higher is slower and safer.
# BCRYPT_ROUNDS=12
